# 复制为 .env 并填写；首次启动用该密码创建超级管理员 admin。
# 之后修改此变量不会重置已有密码（密码已入库），重置请在管理控制台操作。
# 生产环境必填：至少 12 位强密码，change-me / admin123 / password 等占位值会被拒绝。
# 留空时 prod 启动直接失败；dev/test 会生成随机初始口令并写入 BIDCRAFT_HOME/initial-admin.txt。
BIDCRAFT_ADMIN_PASSWORD=

# 会话 Cookie 是否加 Secure 标记：启用 HTTPS 后必须为 1；
# 仅 HTTP 访问（如 ICP 备案期间用 IP 直连）时设为 0，否则无法登录。
BIDCRAFT_SECURE_COOKIE=1

# 运行环境：dev / test / prod（prod 会强校验模型、管理员口令与支付参数）。
BIDCRAFT_ENV=prod

# 反向代理后面才开启：信任 X-Forwarded-For 作为真实客户端 IP（限流/审计用）。
# 直连部署务必保持 0，否则客户端可伪造 IP 绕过限流。
# bidcraft serve 会把此开关透传给 uvicorn（关闭时不启用其 ProxyHeadersMiddleware）；
# 直接 uvicorn bidcraft.api:app 启动时请加 --no-proxy-headers。
BIDCRAFT_TRUST_PROXY=0

# 可选：CSRF 校验时除同源外额外接受的 Origin（逗号分隔）；多域名/反代场景使用。
# BIDCRAFT_PUBLIC_ORIGIN=https://bid.example.com,https://admin.example.com

# 内置 bidcraft backup 额外打包的数据目录（相对 BIDCRAFT_HOME，逗号分隔；空串只备份库与密钥）。
BIDCRAFT_BACKUP_DIRS=projects,packages,output,docs

# 认证敏感端点的进程内滑动窗口限流（0 关闭）。多 worker 时请在反代层再限一次。
BIDCRAFT_RATE_LIMIT=1
BIDCRAFT_RATE_WINDOW_SECONDS=300
BIDCRAFT_RATE_LOGIN_IP=60          # 登录：每 IP / 5 分钟
BIDCRAFT_RATE_LOGIN_GLOBAL=1000    # 登录：每进程 / 5 分钟
BIDCRAFT_RATE_SENSITIVE_IP=30      # 注册、改密、兑换码、模型测试：每 IP
BIDCRAFT_RATE_SENSITIVE_GLOBAL=300

# 基础日志：INFO/DEBUG/...，格式 text 或 json（json 含 request_id，便于集中采集）。
BIDCRAFT_LOG_LEVEL=INFO
BIDCRAFT_LOG_FORMAT=text

# 多实例 PostgreSQL 部署必须在所有进程使用同一把主密钥：共享 secret.key 文件或
# 统一设置本变量（32 字节 Fernet 密钥的 base64，可用 python -c 生成）。
# 单机默认留空，自动使用 BIDCRAFT_HOME/secret.key。
# BIDCRAFT_SECRET_KEY=

# 知识库向量化每批发送的文本数（1~64）。云端 embedding API 可用默认 16；
# 本地 CPU 向量模型（如 TEI fp16）较慢，建议 4，避免单批超过模型超时。
BIDCRAFT_KB_VECTOR_BATCH=16
