# 复制为 .env 并填写；首次启动用该密码创建超级管理员 admin。
# 之后修改此变量不会重置已有密码（密码已入库），重置请在管理控制台操作。
BIDCRAFT_ADMIN_PASSWORD=change-me

# 会话 Cookie 是否加 Secure 标记：启用 HTTPS 后必须为 1；
# 仅 HTTP 访问（如 ICP 备案期间用 IP 直连）时设为 0，否则无法登录。
BIDCRAFT_SECURE_COOKIE=1

# 知识库向量化每批发送的文本数（1~64）。云端 embedding API 可用默认 16；
# 本地 CPU 向量模型（如 TEI fp16）较慢，建议 4，避免单批超过模型超时。
BIDCRAFT_KB_VECTOR_BATCH=16
